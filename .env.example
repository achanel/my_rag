# Free local alternative via Ollama (see README → "Free local LLM"):
# set OPENAI_API_KEY=ollama (not checked, but must be non-empty) and uncomment
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
# MY_RAG_EMBEDDING_MODEL=all-minilm   # optional; per-provider default (Ollama all-minilm)
# MY_RAG_EMBEDDING_DIMENSION=384      # optional; chapter 6 vector size (Ollama all-minilm 384, OpenAI 1536)
# MY_RAG_VISION_MODEL=gemma3:12b      # optional; chapter 4 vision model (Ollama gemma3:12b, OpenAI gpt-4o)
ACTIVELOOP_TOKEN=                     # only needed for hub:// Deep Lake paths (chapter 2 is local)
# Chapter 6: Qdrant runs locally by default (embedded engine, no key, no server).
# MY_RAG_QDRANT_COLLECTION=bank-index-50000  # optional; default collection name
# MY_RAG_QDRANT_PATH=data/processed/qdrant    # optional; local index location
# QDRANT_URL=http://localhost:6333            # optional; use a running Qdrant server instead
# QDRANT_API_KEY=                             # optional; only for a secured remote server
