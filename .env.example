# Free local alternative via Ollama (see README → "Free local LLM"):
# set OPENAI_API_KEY=ollama (not checked, but must be non-empty) and uncomment
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
# MY_RAG_EMBEDDING_MODEL=all-minilm   # optional; per-provider default (Ollama all-minilm)
# MY_RAG_EMBEDDING_DIMENSION=384      # optional; chapter 6 vector size (Ollama all-minilm 384, OpenAI 1536)
# MY_RAG_VISION_MODEL=gemma3:12b      # optional; chapter 4 vision model (Ollama gemma3:12b, OpenAI gpt-4o)
ACTIVELOOP_TOKEN=                     # only needed for hub:// Deep Lake paths (chapter 2 is local)
# Chapter 6: Qdrant runs locally by default (embedded engine, no key, no server).
# MY_RAG_QDRANT_COLLECTION=bank-index-50000  # optional; default collection name
# MY_RAG_QDRANT_PATH=data/processed/qdrant    # optional; local index location
# QDRANT_URL=http://localhost:6333            # optional; use a running Qdrant server instead
# QDRANT_API_KEY=                             # optional; only for a secured remote server
# Chapter 7: the knowledge graph is built with LlamaIndex + Ollama and persisted locally.
# MY_RAG_GRAPH_STORE=data/processed/graph_store   # optional; graph index location
# MY_RAG_GRAPH_LIMIT=15                            # optional; Marketing pages the graph is built from
# Chapter 9: local Apple MLX LoRA fine-tuning — open source, no key (Apple silicon + `pip install "mlx-lm[train]"`).
# MY_RAG_FINETUNE_DATA=data/processed/finetune/qa_prompts_and_completions.jsonl  # optional; chat fine-tuning JSONL
# MY_RAG_FINETUNE_LIMIT=500                       # optional; SciQ rows turned into examples
# MY_RAG_MLX_DATA=data/processed/finetune/mlx         # optional; train.jsonl directory for mlx_lm.lora
# MY_RAG_MLX_ADAPTERS=data/processed/finetune/adapters # optional; LoRA adapters (train output + load path)
# MY_RAG_MLX_ITERS=600                            # optional; MLX LoRA training iterations
# Chapter 10: RAG over the book's stock-video frame comments (Qdrant + a vision model).
# MY_RAG_VIDEO_DIR=data/raw/videos              # optional; downloaded stock videos
# MY_RAG_VIDEO_COMMENTS=data/raw/video_comments # optional; comment CSVs (book's or --comment-video)
# MY_RAG_VIDEO_FRAMES=data/raw/video_frames     # optional; split frames and thumbnails
# MY_RAG_VIDEO_COLLECTION=videos-sports-us      # optional; Qdrant collection name
# MY_RAG_VIDEO_SAMPLE=3                          # optional; comment every Nth frame
# MY_RAG_VIDEO_LIMIT=6                           # optional; sampled frames --comment-video describes (0 = all)
